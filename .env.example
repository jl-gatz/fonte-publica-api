# Copy this file to:
# .env.dev
# .env.test
# .env.prod
#
# Then adjust values for each environment.

# =========================================================
# Application
# =========================================================

# Nome do serviço (usado em logs, healthcheck, observabilidade)
SERVICE_NAME=farol-publico

# Ambiente da aplicação
# Valores comuns: dev | test | prod
ENVIRONMENT=dev


# =========================================================
# Logging
# =========================================================

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# =========================================================
# Database
# =========================================================

# URL do banco no formato SQLAlchemy
# Exemplos:
# PostgreSQL -> postgresql+psycopg://user:password@localhost:5432/dbname
# SQLite     -> sqlite:///./app.db
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/farol


# =========================================================
# Development helpers (opcional)
# =========================================================

# Ativa modo debug (somente dev)
DEBUG=true


# =========================================================
# Observability / metadata (opcional)
# =========================================================

# Versão da aplicação (pode vir do CI)
APP_VERSION=0.1.0

# Commit SHA (usado em health endpoints)
GIT_COMMIT=unknown